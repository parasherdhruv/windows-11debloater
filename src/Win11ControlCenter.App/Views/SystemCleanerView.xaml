<UserControl x:Class="Win11ControlCenter.App.Views.SystemCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SystemCleanerViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="System Cleaner &amp; Maintenance" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource SegoeFluent}" />
                <TextBlock Text="Safely scan and clean temporary system caches, crash dumps, and Recycle Bin without touching user personal files or drivers." 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Select All" Style="{DynamicResource ModernButton}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                <Button Content="Deselect All" Style="{DynamicResource ModernButton}" Command="{Binding DeselectAllCommand}" Margin="0,0,8,0" />
                <Button Content="🔄 Scan System" Style="{DynamicResource ModernButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <Button Content="🧹 Clean Selected Items" Style="{DynamicResource DangerButton}" Command="{Binding CleanSelectedCommand}" />
            </StackPanel>
        </Grid>

        <!-- Metric Stat Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Scanned -->
            <Border Grid.Column="0" Style="{DynamicResource FluentCard}" Margin="0,0,8,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="TOTAL CLUTTER SCANNED" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalScannedFormatted}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Temporary caches on disk" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Selected to Clean -->
            <Border Grid.Column="1" Style="{DynamicResource FluentCardElevated}" Margin="4,0,4,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="SELECTED TO CLEAN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{Binding TotalSelectedFormatted}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Reclaimable storage space" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Files Selected -->
            <Border Grid.Column="2" Style="{DynamicResource FluentCard}" Margin="4,0,4,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="SELECTED FILES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding TotalSelectedFiles}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Ready for safe purging" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Safety Guarantee -->
            <Border Grid.Column="3" Style="{DynamicResource FluentCard}" Margin="8,0,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="SAFETY GUARANTEE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock Text="100% Protected" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Zero user files or drivers touched" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Segmented Tab Filter (All / Selected Only) -->
        <Border Grid.Row="2" Background="#18181C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="4,2" HorizontalAlignment="Left" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="All Categories" Style="{DynamicResource SegmentPillButton}" IsChecked="{Binding IsAllTabActive}" 
                             Command="{Binding SwitchTabCommand}" CommandParameter="All" />
                
                <RadioButton Style="{DynamicResource SegmentPillButton}" IsChecked="{Binding IsSelectedTabActive}" 
                             Command="{Binding SwitchTabCommand}" CommandParameter="Selected">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Selected Targets (" />
                        <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" />
                        <TextBlock Text=")" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Selected Targets Quick Shelf / Tray (Surfaces selected targets with instant uncheck) -->
        <Border Grid.Row="3" Style="{DynamicResource FluentCardElevated}" Margin="0,0,0,12" Padding="12,10"
                Visibility="{Binding HasSelectedTargets, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Selected Targets (" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="):" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                </StackPanel>

                <!-- Horizontal Scrollable Chips of Selected Targets -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedTargets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#253545" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" Margin="0,0,6,0" />
                                        <Button Command="{Binding DataContext.UnselectTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Content="✕" Cursor="Hand" Background="Transparent" BorderThickness="0" 
                                                Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="11" Padding="2,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="2" Content="Deselect All" Command="{Binding DeselectAllCommand}" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                        FontSize="11" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Targets List -->
        <Border Grid.Row="4" Style="{DynamicResource FluentCard}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161619" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Style="{DynamicResource StatusBadge}" Margin="10,0,0,0" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="🛡️ Admin Required" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding TargetPath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" />
                                    </StackPanel>

                                    <!-- File Count Badge -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" Padding="10,4" CornerRadius="6" Background="#121214" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>

                                    <!-- Reclaimable Size Badge -->
                                    <Border Grid.Column="3" VerticalAlignment="Center" Padding="12,6" CornerRadius="6" Background="#202026" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="90">
                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Cleanup Confirmation Modal -->
        <Border Grid.RowSpan="5" Background="#C0000000" Visibility="{Binding IsPlanModalOpen, Converter={StaticResource BoolToVisConverter}}" Margin="-24">
            <Border Width="680" MaxHeight="550" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Review Storage Cleanup Plan" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="The following temporary directories and caches will be cleaned." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Warning Banner & Dry Run -->
                    <Border Grid.Row="1" Background="#2A1800" BorderBrush="#885500" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⚠️ Notice: " FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" FontSize="12" />
                                <TextBlock Text="File cleanup is permanent. Locked or active process files are automatically skipped." Foreground="{DynamicResource WarningBrush}" FontSize="12" />
                            </StackPanel>
                            <CheckBox Content="🧪 Dry-Run Mode (Simulate cleanup without deleting any files)" IsChecked="{Binding IsDryRun}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Items List -->
                    <Border Grid.Row="2" Background="#141416" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,16">
                        <ListBox ItemsSource="{Binding ActivePlan.Items}" Background="Transparent" BorderThickness="0" MaxHeight="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Target}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" FontFamily="Consolas" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{DynamicResource StatusBadge}">
                                            <TextBlock Text="Permanent" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Progress Indicator -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,16" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}">
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,0,0,6" Foreground="{DynamicResource AccentLightBrush}" />
                        <TextBlock Text="{Binding ProgressStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🛡️ User personal files strictly protected" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Style="{DynamicResource ModernButton}" Command="{Binding CancelModalCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsNotExecuting}" />
                            <Button Content="Confirm &amp; Clean Files" Style="{DynamicResource DangerButton}" Command="{Binding ExecuteCleanCommand}" IsEnabled="{Binding IsNotExecuting}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
