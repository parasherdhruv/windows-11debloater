<UserControl x:Class="Win11ControlCenter.App.Views.ServicesManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ServicesManagerViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Windows Services Manager" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource SegoeFluent}" />
                <TextBlock Text="Inspect Windows background services and dependency graphs. Core services are strictly protected." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export Inventory" Style="{DynamicResource ModernButton}" Command="{Binding ExportInventoryCommand}" Margin="0,0,8,0" />
                <Button Content="Refresh Services" Style="{DynamicResource ModernButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Style="{DynamicResource FluentCard}" Padding="8,6" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource SegoeEmoji}" />
                <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                         BorderThickness="0" VerticalAlignment="Center" FontSize="13" FontFamily="{DynamicResource SegoeFluent}" />
            </Grid>
        </Border>

        <!-- Master-Detail Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Services List -->
            <Border Grid.Column="0" Style="{DynamicResource FluentCard}" Padding="6,8" Margin="0,0,12,0">
                <ListBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="serviceCard" Background="{DynamicResource SubCardBackgroundBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="10,8">
                                            <Grid>
                                                <Rectangle x:Name="indicator" Width="3" Height="18" Fill="{DynamicResource AccentLightBrush}" 
                                                           HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Margin="-6,0,0,0" />
                                                <ContentPresenter Margin="2,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="serviceCard" Property="Background" Value="{DynamicResource SubCardHoverBrush}" />
                                                <Setter TargetName="serviceCard" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="serviceCard" Property="Background" Value="{DynamicResource CardElevatedBackgroundBrush}" />
                                                <Setter TargetName="serviceCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Service Icon Badge -->
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" 
                                        Background="{DynamicResource IconBadgeBackgroundBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,12,0">
                                    <TextBlock Text="⚙️" FontSize="15" Foreground="{DynamicResource IconForegroundBrush}" FontFamily="{DynamicResource SegoeEmoji}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Service Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <Border CornerRadius="6" Background="{DynamicResource PillRailBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ServiceName}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Style="{DynamicResource StatusBadge}" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" Margin="6,0,0,0" 
                                                Visibility="{Binding IsCoreService, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="🛡️ Core Protected" FontSize="10.5" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Status Badge with Colored Indicator Dot -->
                                <Border Grid.Column="2" CornerRadius="12" Padding="9,3" BorderThickness="1" VerticalAlignment="Center" Margin="10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PillRailBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="○" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Text" Value="●" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Startup Type Badge -->
                                <Border Grid.Column="3" CornerRadius="12" Padding="9,3" BorderThickness="1" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PillRailBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartupType}" Value="Automatic">
                                                    <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StartupType}" Value="Disabled">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StartupType}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StartupType}" Value="Automatic">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StartupType}" Value="Disabled">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

                <!-- Right: Service Detail Inspector -->
                <Border Grid.Column="1" Style="{DynamicResource FluentCard}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Service Inspector" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="SERVICE DISPLAY NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedService.DisplayName, FallbackValue='Select a service from the list'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,10" />

                            <TextBlock Text="INTERNAL SERVICE NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedService.ServiceName, FallbackValue='N/A'}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,10" />

                            <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedService.Description, FallbackValue='N/A'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,12" />

                            <TextBlock Text="EXECUTABLE BINARY PATH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedService.BinaryPath, FallbackValue='N/A'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,12" />

                            <!-- Current State and Controls -->
                            <TextBlock Text="SERVICE STATE CONTROLS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Content="▶ Start Service" Style="{DynamicResource ModernButton}" Command="{Binding StartSelectedServiceCommand}" Margin="0,0,8,0" />
                                <Button Content="⏹ Stop Service" Style="{DynamicResource ModernButton}" Command="{Binding StopSelectedServiceCommand}" IsEnabled="{Binding SelectedService.CanBeModified, FallbackValue=False}" />
                            </StackPanel>

                            <!-- Startup Configuration Controls -->
                            <TextBlock Text="STARTUP TYPE CONFIGURATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="Set Manual (Demand)" Style="{DynamicResource ModernButton}" 
                                        Command="{Binding SetStartupTypeCommand}" CommandParameter="Manual" 
                                        IsEnabled="{Binding SelectedService.CanBeModified, FallbackValue=False}" Margin="0,0,4,6" />
                                <Button Content="Set Automatic" Style="{DynamicResource ModernButton}" 
                                        Command="{Binding SetStartupTypeCommand}" CommandParameter="Automatic" 
                                        IsEnabled="{Binding SelectedService.CanBeModified, FallbackValue=False}" Margin="4,0,0,6" />
                                <Button Content="Set Disabled" Style="{DynamicResource DangerButton}" 
                                        Command="{Binding SetStartupTypeCommand}" CommandParameter="Disabled" 
                                        IsEnabled="{Binding SelectedService.CanBeModified, FallbackValue=False}" Margin="0,0,4,0" />
                                <Button Content="Restore Original" Style="{DynamicResource ModernButton}" 
                                        Command="{Binding RestoreStartupTypeCommand}" 
                                        IsEnabled="{Binding SelectedService.CanBeModified, FallbackValue=False}" Margin="4,0,0,0" />
                            </UniformGrid>

                            <!-- Dependencies Section -->
                            <TextBlock Text="SERVICE DEPENDENCIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,4" />
                            <TextBlock Text="Dependencies count:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding SelectedService.Dependencies}" Margin="0,2,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Safety Guarantee Box -->
                            <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Core Windows Services Shield" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="Foundational Windows infrastructure services (RPC, Defender, Networking, EventLog, Windows Update) cannot be stopped or disabled." 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
</UserControl>
