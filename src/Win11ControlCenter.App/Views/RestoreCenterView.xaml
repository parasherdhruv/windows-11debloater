<UserControl x:Class="Win11ControlCenter.App.Views.RestoreCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RestoreCenterViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🛡️ System Recovery &amp; Restore Center" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Automated pre-optimization snapshots, emergency .reg rollback files, and Windows System Restore checkpoint integration." 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔄 Refresh" Style="{DynamicResource ModernButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="➕ Create Restore Checkpoint" Style="{DynamicResource AccentButton}" Command="{Binding CreateRestorePointCommand}" />
            </StackPanel>
        </Grid>

        <!-- Status Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- System Restore Status -->
            <Border Grid.Column="0" Style="{DynamicResource FluentCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="SYSTEM PROTECTION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SystemRestoreStatusText}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemRestoreAvailable}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Windows System Restore state" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Total Backups -->
            <Border Grid.Column="1" Style="{DynamicResource FluentCard}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="SAVED BACKUPS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding Backups.Count}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Local rollback snapshots" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Rollback Architecture -->
            <Border Grid.Column="2" Style="{DynamicResource FluentCard}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="ROLLBACK FIDELITY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock Text="Dual Mechanism" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Typed Plan + Emergency .REG" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Reversibility Guarantee -->
            <Border Grid.Column="3" Style="{DynamicResource FluentCard}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="SAFETY SHIELD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Non-Destructive" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Reversible configuration changes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Master-Detail Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Backups List -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock Text="Configuration Snapshots" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right" Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,1">
                            <TextBlock Text="{Binding Backups.Count, StringFormat='{}{0} Total'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- Search Filter -->
                    <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource SegoeEmoji}" FontSize="12" />
                            <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                     BorderThickness="0" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource SegoeFluent}" />
                        </Grid>
                    </Border>

                    <!-- Direct Virtualized ListBox with Modern Fluent Container Style -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" 
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemCard" Background="{DynamicResource SubCardBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="10,9">
                                                <Grid>
                                                    <Rectangle x:Name="indicator" Width="3" Height="20" Fill="{DynamicResource AccentLightBrush}" 
                                                               HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Margin="-6,0,0,0" />
                                                    <ContentPresenter Margin="2,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemCard" Property="Background" Value="{DynamicResource SubCardHoverBrush}" />
                                                    <Setter TargetName="itemCard" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemCard" Property="Background" Value="{DynamicResource CardElevatedBackgroundBrush}" />
                                                    <Setter TargetName="itemCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Shield Icon Badge -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" 
                                            Background="{DynamicResource IconBadgeBackgroundBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1" 
                                            Margin="0,0,10,0" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="🛡️" FontSize="15" Foreground="{DynamicResource IconForegroundBrush}" FontFamily="{DynamicResource SegoeEmoji}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Details (Title, ID, Formatted Date) -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                            <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ShortId, StringFormat='#{0}'}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FormattedTimestamp}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Counts Badges (Reg / Svc) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Border Style="{DynamicResource StatusBadge}" Background="{DynamicResource PillRailBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,4,0" Padding="6,2">
                                            <TextBlock Text="{Binding RegistryEntriesCount, StringFormat='{}{0} Reg'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Style="{DynamicResource StatusBadge}" Background="{DynamicResource PillRailBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="6,2">
                                            <TextBlock Text="{Binding ServicesCount, StringFormat='{}{0} Svc'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Selected Backup Details -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Title & Actions Card -->
                        <Border Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Big Shield Badge -->
                                <Border Grid.RowSpan="2" Grid.Column="0" Width="46" Height="46" CornerRadius="10" 
                                        Background="{DynamicResource IconBadgeBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                        Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="🛡️" FontSize="22" Foreground="{DynamicResource IconForegroundBrush}" FontFamily="{DynamicResource SegoeEmoji}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Title, Profile and Date -->
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedBackup.DisplayTitle, FallbackValue='No Backup Selected'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                        <Border Style="{DynamicResource StatusBadge}" Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding SelectedBackup.ShortId, Converter={StaticResource NullOrEmptyToVisConverter}}">
                                            <TextBlock Text="{Binding SelectedBackup.ShortId, StringFormat='#{0}'}" FontSize="10.5" Foreground="{DynamicResource AccentLightBrush}" FontFamily="Consolas" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedBackup.FormattedTimestamp}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding SelectedBackup.Description, Converter={StaticResource NullOrEmptyToVisConverter}}" />
                                        <TextBlock Text="{Binding SelectedBackup.Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons Row -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="↩️ Rollback Snapshot" Style="{DynamicResource AccentButton}" Command="{Binding RestoreSelectedBackupCommand}" Margin="0,0,10,0" />
                                    <Button Content="📂 Open Folder" Style="{DynamicResource ModernButton}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,10,0" />
                                    <Button Content="🗑️ Delete" Style="{DynamicResource DangerButton}" Command="{Binding DeleteBackupCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Path Display -->
                        <Border Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SNAPSHOT STORAGE LOCATION:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedBackup.Path}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Breakdown Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SubCardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="REGISTRY VALUES" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedBackup.RegistryEntriesCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource SubCardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="2,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="SERVICES" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedBackup.ServicesCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SubCardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="4,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="STARTUP ITEMS" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedBackup.StartupCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{DynamicResource SubCardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PACKAGES" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedBackup.PackageCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource BannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="💡 About Emergency Rollback" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,0,4" />
                                <TextBlock Text="Each snapshot creates a standalone .reg file located in the 'registry' subfolder. Even if Win11 Control Center is closed or uninstalled, double-clicking 'pre_apply_rollback.reg' in Windows Explorer will instantly restore all registry settings to their pre-modification state." 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Restore / Checkpoint Modal -->
        <Border Grid.RowSpan="3" Background="#AA000000" Visibility="{Binding IsRestoreModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="500" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Recovery Operation" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <!-- Status Text -->
                    <Border Grid.Row="1" Background="{DynamicResource SubCardBackgroundBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <TextBlock Text="{Binding RestoreStatusMessage}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Progress Bar -->
                    <ProgressBar Grid.Row="2" IsIndeterminate="{Binding IsRestoring}" Maximum="100" Height="4" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}" />

                    <!-- Close Button -->
                    <Button Grid.Row="3" Content="Dismiss" Style="{DynamicResource ModernButton}" Command="{Binding CloseModalCommand}" HorizontalAlignment="Right" Width="100" IsEnabled="{Binding IsNotRestoring}" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
