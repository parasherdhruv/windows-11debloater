<UserControl x:Class="Win11ControlCenter.App.Views.AppDebloaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AppDebloaterViewModel}"
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="24">
        <!-- Main Content Area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Application Debloater" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource SegoeFluent}" />
                    <TextBlock Text="Audit and safely remove unwanted Windows applications. Core components are protected." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ 1-Click Debloat" Style="{DynamicResource PrimaryButton}" Command="{Binding QuickDebloatCommand}" Margin="0,0,8,0" />
                    <Button Content="✨ Select Safe Bloat" Style="{DynamicResource ModernButton}" Command="{Binding SelectAllSafeCommand}" Margin="0,0,8,0" />
                    <Button Content="Clear Selection" Style="{DynamicResource ModernButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                    <Button Content="🔄 Refresh" Style="{DynamicResource ModernButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource ModernButton}" Command="{Binding PreviewRemovalPlanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Preview Removal (" />
                            <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" />
                            <TextBlock Text=")" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search, Tabs & Quick Filter Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Style="{DynamicResource FluentCard}" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource SegoeEmoji}" />
                        <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                 BorderThickness="0" VerticalAlignment="Center" FontSize="13" FontFamily="{DynamicResource SegoeFluent}" />
                    </Grid>
                </Border>

                <!-- Segmented Tabs (All / Selected / Safe) -->
                <Border Grid.Column="1" Background="{DynamicResource PillRailBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="All Applications" Style="{DynamicResource SegmentPillButton}" GroupName="DebloaterTabsGroup" IsChecked="{Binding IsAllTabActive}" 
                                     Command="{Binding SwitchTabCommand}" CommandParameter="All" />
                        
                        <RadioButton Style="{DynamicResource SegmentPillButton}" GroupName="DebloaterTabsGroup" IsChecked="{Binding IsSelectedTabActive}" 
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Selected">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Selected Only (" />
                                <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" />
                                <TextBlock Text=")" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Content="Safe Recommendations" Style="{DynamicResource SegmentPillButton}" GroupName="DebloaterTabsGroup" IsChecked="{Binding IsSafeBloatTabActive}" 
                                     Command="{Binding SwitchTabCommand}" CommandParameter="SafeBloat" />
                    </StackPanel>
                </Border>

                <!-- Pin Selected To Top Toggle -->
                <CheckBox Grid.Column="2" Content="Pin Selected to Top" IsChecked="{Binding PinSelectedToTop}" 
                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>

            <!-- Selected Applications Shelf / Tray (Surfaces what has been selected) -->
            <Border Grid.Row="2" Style="{DynamicResource FluentCardElevated}" Margin="0,0,0,12" Padding="12,10"
                    Visibility="{Binding HasSelectedPackages, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Selected for Removal (" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                        <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                        <TextBlock Text="):" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                    </StackPanel>

                    <!-- Horizontal Scrollable Chips of Selected Packages -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedPackages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                                            <Button Command="{Binding DataContext.UnselectPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Content="✕" Cursor="Hand" Background="Transparent" BorderThickness="0" 
                                                    Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="11" Padding="2,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Column="2" Content="Clear All" Command="{Binding ClearSelectionCommand}" 
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                            FontSize="11" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <!-- Master-Detail Layout -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Application List -->
                <Border Grid.Column="0" Style="{DynamicResource FluentCard}" Padding="6,8" Margin="0,0,12,0">
                    <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemCard" Background="{DynamicResource SubCardBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="10,8">
                                                <Grid>
                                                    <Rectangle x:Name="indicator" Width="3" Height="18" Fill="{DynamicResource AccentLightBrush}" 
                                                               HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Margin="-6,0,0,0" />
                                                    <ContentPresenter Margin="2,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemCard" Property="Background" Value="{DynamicResource SubCardHoverBrush}" />
                                                    <Setter TargetName="itemCard" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemCard" Property="Background" Value="{DynamicResource CardElevatedBackgroundBrush}" />
                                                    <Setter TargetName="itemCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox IsChecked="{Binding IsSelectedForRemoval, Mode=TwoWay}" IsEnabled="{Binding IsRemovable}" VerticalAlignment="Center" Margin="2,0,10,0" />

                                    <!-- App Glyph / Icon Container -->
                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" 
                                            Background="{DynamicResource IconBadgeBackgroundBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1" 
                                            VerticalAlignment="Center" 
                                            Margin="0,0,12,0">
                                        <TextBlock Text="📦" FontSize="15" Foreground="{DynamicResource IconForegroundBrush}" FontFamily="{DynamicResource SegoeEmoji}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- App Info -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{DynamicResource StatusBadge}" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" Margin="8,0,0,0" 
                                                    Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="🛡️ Protected" FontSize="10.5" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Publisher}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                            <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding Version, Converter={StaticResource NullOrEmptyToVisConverter}}" />
                                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding Version, Converter={StaticResource NullOrEmptyToVisConverter}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Size Pill -->
                                    <Border Grid.Column="3" Background="{DynamicResource PillRailBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Risk Badge with dynamic color tint -->
                                    <Border Grid.Column="4" CornerRadius="12" Padding="9,3" BorderThickness="1" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource PillRailBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Safe">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Moderate">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Advanced">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Critical">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RiskLevel}" FontSize="11" Foreground="{Binding RiskLevel, Converter={StaticResource RiskToBrushConverter}}" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Right: Package Inspector Panel -->
                <Border Grid.Column="1" Style="{DynamicResource FluentCard}" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Package Inspector" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="APPLICATION NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedPackage.DisplayName, FallbackValue='Select an application to inspect'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />

                            <TextBlock Text="PACKAGE IDENTITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedPackage.PackageFullName, FallbackValue='N/A'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,12" />

                            <TextBlock Text="PUBLISHER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedPackage.Publisher, FallbackValue='N/A'}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />

                            <TextBlock Text="VERSION &amp; TYPE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                <TextBlock Text="{Binding SelectedPackage.Version, FallbackValue='1.0.0'}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                <Border Style="{DynamicResource StatusBadge}">
                                    <TextBlock Text="{Binding SelectedPackage.PackageType, FallbackValue='AppX'}" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="REMOVAL RISK CLASSIFICATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                <Border Style="{DynamicResource StatusBadge}">
                                    <TextBlock Text="{Binding SelectedPackage.RiskLevel, FallbackValue='Safe'}" FontSize="11" Foreground="{Binding SelectedPackage.RiskLevel, Converter={StaticResource RiskToBrushConverter}}" FontWeight="Bold" />
                                </Border>
                                <Border Style="{DynamicResource StatusBadge}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SelectedPackage.Category, FallbackValue='SafeConsumer'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="REMOVAL SCOPE OPTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,4" />
                            <CheckBox IsChecked="{Binding SelectedPackage.RemoveProvisioningToo, FallbackValue=True}" 
                                      Content="Also remove package provisioning for new accounts" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,14" />

                            <!-- Safety Warning Banner -->
                            <Border Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource BannerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="🛡️ Reversibility Note" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                                    <TextBlock Text="Removing an application deletes its local packages. You can easily re-install it anytime via the Microsoft Store or our integrated Software Center." 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Operation Summary & Confirmation Modal Overlay -->
        <Border Background="#C0000000" Visibility="{Binding IsPlanModalOpen, Converter={StaticResource BoolToVisConverter}}" Margin="-24">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Width="680" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Review Removal Plan" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Verify the applications selected for uninstallation before proceeding." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Selected Items List -->
                    <Border Grid.Row="1" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,16">
                        <ListBox ItemsSource="{Binding ActivePlan.Items}" Background="Transparent" BorderThickness="0" MaxHeight="250">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Grid.Column="1" Style="{DynamicResource StatusBadge}" Margin="8,0">
                                            <TextBlock Text="{Binding RiskLevel}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <Border Grid.Column="2" Style="{DynamicResource StatusBadge}">
                                            <TextBlock Text="{Binding Reversibility}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Progress Indicator -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}">
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,0,0,6" Foreground="{DynamicResource AccentLightBrush}" />
                        <TextBlock Text="{Binding ProgressStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🛡️ Safety Shield: All system components are verified safe." VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Close" Style="{DynamicResource ModernButton}" Command="{Binding CloseModalCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsNotExecuting}" />
                            <Button Content="Dry-Run Simulation" Style="{DynamicResource ModernButton}" Command="{Binding DryRunSimulationCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsNotExecuting}" />
                            <Button Content="Confirm &amp; Execute Removal" Style="{DynamicResource DangerButton}" Command="{Binding ExecuteConfirmedPlanCommand}" IsEnabled="{Binding IsNotExecuting}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
