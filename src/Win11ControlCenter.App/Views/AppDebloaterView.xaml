<UserControl x:Class="Win11ControlCenter.App.Views.AppDebloaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AppDebloaterViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24">
        <!-- Main Content Area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Application Debloater" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource SegoeFluent}" />
                    <TextBlock Text="Audit and safely remove unwanted Windows applications. Core components are protected." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Select All Safe" Style="{DynamicResource ModernButton}" Command="{Binding SelectAllSafeCommand}" Margin="0,0,8,0" />
                    <Button Content="Clear Selection" Style="{DynamicResource ModernButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                    <Button Content="Refresh" Style="{DynamicResource ModernButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource PrimaryButton}" Command="{Binding PreviewRemovalPlanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Preview Removal Plan (" />
                            <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" />
                            <TextBlock Text=")" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search and Filter Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{DynamicResource FluentCard}" Padding="8,6" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                                 BorderThickness="0" VerticalAlignment="Center" FontSize="13" FontFamily="{StaticResource SegoeFluent}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Master-Detail Layout -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Application List -->
                <Border Grid.Column="0" Style="{DynamicResource FluentCard}" Padding="0" Margin="0,0,12,0">
                    <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#2560CDFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox IsChecked="{Binding IsSelectedForRemoval}" IsEnabled="{Binding IsRemovable}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <!-- App Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{DynamicResource StatusBadge}" Background="#3B2612" BorderBrush="#8A5A1C" Margin="8,0,0,0" 
                                                    Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="🛡️ Protected" FontSize="11" Foreground="#FFC875" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Publisher}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0" />

                                    <!-- Risk Badge -->
                                    <Border Grid.Column="3" Style="{DynamicResource StatusBadge}">
                                        <TextBlock Text="{Binding RiskLevel}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Right: Package Inspector Panel -->
                <Border Grid.Column="1" Style="{DynamicResource FluentCard}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Package Inspector" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="APPLICATION NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedPackage.DisplayName, FallbackValue='Select an application to inspect'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />

                            <TextBlock Text="PACKAGE IDENTITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedPackage.PackageFullName, FallbackValue='N/A'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,12" />

                            <TextBlock Text="PUBLISHER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedPackage.Publisher, FallbackValue='N/A'}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />

                            <TextBlock Text="VERSION &amp; TYPE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                <TextBlock Text="{Binding SelectedPackage.Version, FallbackValue='1.0.0'}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                <Border Style="{DynamicResource StatusBadge}">
                                    <TextBlock Text="{Binding SelectedPackage.PackageType, FallbackValue='AppX'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="REMOVAL RISK CLASSIFICATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                <Border Style="{DynamicResource StatusBadge}">
                                    <TextBlock Text="{Binding SelectedPackage.RiskLevel, FallbackValue='Safe'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <Border Style="{DynamicResource StatusBadge}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SelectedPackage.Category, FallbackValue='SafeConsumer'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="REMOVAL SCOPE OPTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,4" />
                            <CheckBox IsChecked="{Binding SelectedPackage.RemoveProvisioningToo, FallbackValue=True}" 
                                      Content="Also remove package provisioning for new accounts" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,14" />

                            <!-- Safety Warning Banner -->
                            <Border Background="#20FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Reversibility Note" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Removing an application deletes its local assets. To restore it later, re-download it via the Microsoft Store or Windows Package Manager (winget)." 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Operation Summary & Confirmation Modal Overlay -->
        <Border Background="#C0000000" Visibility="{Binding IsPlanModalOpen, Converter={StaticResource BoolToVisConverter}}" Margin="-24">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Width="680" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Review Removal Plan" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Verify the applications selected for uninstallation before proceeding." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Selected Items List -->
                    <Border Grid.Row="1" Background="#181818" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,16">
                        <ListBox ItemsSource="{Binding ActivePlan.Items}" Background="Transparent" BorderThickness="0" MaxHeight="250">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Grid.Column="1" Style="{DynamicResource StatusBadge}" Margin="8,0">
                                            <TextBlock Text="{Binding RiskLevel}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <Border Grid.Column="2" Style="{DynamicResource StatusBadge}">
                                            <TextBlock Text="{Binding Reversibility}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Progress Indicator -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}">
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,0,0,6" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding ProgressStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Safety Shield: All system components are verified safe." VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Close" Style="{DynamicResource ModernButton}" Command="{Binding CloseModalCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsNotExecuting}" />
                            <Button Content="Dry-Run Simulation" Style="{DynamicResource ModernButton}" Command="{Binding DryRunSimulationCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsNotExecuting}" />
                            <Button Content="Confirm &amp; Execute Removal" Style="{DynamicResource DangerButton}" Command="{Binding ExecuteConfirmedPlanCommand}" IsEnabled="{Binding IsNotExecuting}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
