<UserControl x:Class="Win11ControlCenter.App.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🎮 Gaming Optimization Center" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Tune Windows 11 for consistent framerates and minimal latency: GPU hardware scheduling, DVR background capture elimination, and gaming power delivery." 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔄 Refresh" Style="{DynamicResource ModernButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="⚡ Apply Gaming Optimizations" Style="{DynamicResource AccentButton}" Command="{Binding OptimizeAllGamingCommand}" />
            </StackPanel>
        </Grid>

        <!-- Hardware & Status Overview Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- GPU Hardware Card -->
            <Border Grid.Column="0" Style="{DynamicResource FluentCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="DEDICATED GPU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding GpuName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Hardware-Accelerated" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- CPU & RAM -->
            <Border Grid.Column="1" Style="{DynamicResource FluentCard}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="PROCESSOR &amp; MEMORY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding CpuName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RamAmount, StringFormat='{}{0} System Memory'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Game Mode Status -->
            <Border Grid.Column="2" Style="{DynamicResource FluentCard}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="WINDOWS GAME MODE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock FontSize="18" FontWeight="Bold" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="○ Inactive" />
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameModeActive}" Value="True">
                                        <Setter Property="Text" Value="✓ Active" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Prioritizes GPU/CPU for games" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Active Power Scheme -->
            <Border Grid.Column="3" Style="{DynamicResource FluentCard}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE POWER SCHEME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ActivePowerPlanName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Hardware power state" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Gaming Settings List -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GamingTweaks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1C1C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Details -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Style="{DynamicResource StatusBadge}" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Style="{DynamicResource StatusBadge}" Margin="6,0,0,0" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Reboot Required" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Status Pill -->
                                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,4" CornerRadius="12" Margin="0,0,16,0"
                                            Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="○ Default" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                            <Setter Property="Text" Value="✓ Active" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Action Button -->
                                    <Button Grid.Column="2" VerticalAlignment="Center" Width="90"
                                            Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                <Setter Property="Content" Value="Enable" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                        <Setter Property="Content" Value="Revert" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Execution Modal -->
        <Border Grid.RowSpan="3" Background="#AA000000" Visibility="{Binding IsPlanModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="650" MaxHeight="520" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Review Gaming Optimizations" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Inspect proposed gaming tweaks. Automatic registry rollback points are created before execution." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#181818" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <CheckBox Content="🧪 Dry-Run Mode (Simulate execution and verify without writing to registry)" IsChecked="{Binding IsDryRun}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                    </Border>

                    <Border Grid.Row="2" Background="#141414" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,16">
                        <ListBox ItemsSource="{Binding ActivePlan.Items}" Background="Transparent" BorderThickness="0" MaxHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Target}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{DynamicResource StatusBadge}">
                                            <TextBlock Text="{Binding RecommendedValue, StringFormat='Target: {0}'}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,0,0,16" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}">
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,0,0,6" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding ProgressStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🛡️ Reversible via Restore Center" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Style="{DynamicResource ModernButton}" Command="{Binding CancelModalCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsNotExecuting}" />
                            <Button Content="Confirm &amp; Apply" Style="{DynamicResource AccentButton}" Command="{Binding ExecutePlanCommand}" IsEnabled="{Binding IsNotExecuting}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

