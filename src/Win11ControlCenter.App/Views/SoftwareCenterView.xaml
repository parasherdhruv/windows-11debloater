<UserControl x:Class="Win11ControlCenter.App.Views.SoftwareCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SoftwareCenterViewModel}"
             d:DesignHeight="750" d:DesignWidth="1050">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Essential Clean Software Center" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource SegoeFluent}" />
                <TextBlock Text="Install curated, free and open-source (FOSS) software directly via the official Windows Package Manager (Winget)." 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{DynamicResource StatusBadge}" Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="⚡ Winget Engine Ready" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWingetAvailable}" Value="False">
                                        <Setter Property="Text" Value="⚠️ Winget Not Found" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Button Content="🔄 Refresh Status" Style="{DynamicResource ModernButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Style="{DynamicResource PrimaryButton}" Command="{Binding InstallSelectedCommand}" IsEnabled="{Binding IsNotInstalling}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Install Selected (" />
                        <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" />
                        <TextBlock Text=")" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Security & Source Provenance Banner -->
        <Border Grid.Row="1" Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource BannerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="🏛️" FontSize="14" Foreground="{DynamicResource AccentLightBrush}" FontFamily="{DynamicResource SegoeEmoji}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Official Microsoft Windows Package Manager (Winget) Community Repository" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                        <Border Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="✓ 100% Free &amp; Open Source (FOSS)" FontSize="9" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="All software is distributed under permissive open-source licenses (GPL, MIT, Apache, MPL) or free for personal use. Packages are malware-scanned by Microsoft and downloaded directly from official verified publisher servers with zero copyright infringement risks." 
                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search & Category Filters -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,10,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource SegoeEmoji}" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                             BorderThickness="0" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource SegoeFluent}" />
                </Grid>
            </Border>

            <!-- Category Pills -->
            <Border Grid.Column="1" Background="{DynamicResource PillRailBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="3,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="All" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" IsChecked="True" 
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="All" />
                        <RadioButton Content="Utilities" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" 
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Utilities" />
                        <RadioButton Content="Browsers" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" 
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Browsers" />
                        <RadioButton Content="Developer" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" 
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Developer" />
                        <RadioButton Content="Media" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" 
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Media" />
                        <RadioButton Content="Graphics" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" 
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Graphics" />
                        <RadioButton Content="Security" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" 
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Security" />
                        <RadioButton Content="Productivity" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" 
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Productivity" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Selected Software Tray (Surfaces what has been selected) -->
        <Border Grid.Row="3" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderHighlightBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="8,5"
                Visibility="{Binding HasSelectedPackages, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Selected (" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" />
                </StackPanel>

                <!-- Horizontal Scrollable Chips of Selected Packages -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedPackages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="6,2" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="11" Foreground="{DynamicResource IconForegroundBrush}" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                        <Button Command="{Binding DataContext.UnselectPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Content="✕" Cursor="Hand" Background="Transparent" BorderThickness="0" 
                                                Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="10" Padding="2,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="2" Content="Clear All" Command="{Binding ClearSelectionCommand}" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                        FontSize="11" Cursor="Hand" VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>
        </Border>

        <!-- Live Installation Progress Banner -->
        <Border Grid.Row="4" Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="📦 Installing Package via Winget..." FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{Binding InstallProgressStatus}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource AccentLightBrush}" />
            </StackPanel>
        </Border>

        <!-- Packages List / Cards -->
        <Border Grid.Row="5" Style="{DynamicResource FluentCard}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Packages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsInstalled, Converter={StaticResource InverseBoolConverter}}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <!-- Application Icon Badge -->
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource IconBadgeBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="17" Foreground="{DynamicResource IconForegroundBrush}" FontFamily="{DynamicResource SegoeEmoji}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Details & Metadata -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <!-- Title & Badges Row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            
                                            <!-- Category Badge -->
                                            <Border Style="{DynamicResource StatusBadge}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>

                                            <!-- License Badge (FOSS / Free) -->
                                            <Border Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🟢 " FontSize="8" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding License}" FontSize="10" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Package ID Badge -->
                                            <Border Style="{DynamicResource StatusBadge}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

                                        <!-- Publisher & Provenance Link -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="By " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Publisher}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                            
                                            <!-- Official Website Link Button -->
                                            <Button Command="{Binding DataContext.OpenHomepageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding HomepageUrl}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🌐 " FontSize="11" />
                                                    <TextBlock Text="Official Website" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" TextDecorations="Underline" />
                                                </StackPanel>
                                            </Button>

                                            <TextBlock Text=" • Source: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding RepositorySource}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Installation Status Badge -->
                                    <Border Grid.Column="3" VerticalAlignment="Center" Margin="16,0" Padding="12,5" CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding InstallStatus}" Value="Installing">
                                                        <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding InstallStatus}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding InstallStatus}" Value="Installing">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Action Button -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Button Content="Install" Style="{DynamicResource ModernButton}" Padding="14,6" FontSize="12"
                                                Command="{Binding DataContext.InstallSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                                        <Border Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center">
                                            <TextBlock Text="✓ Installed" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
