<UserControl x:Class="Win11ControlCenter.App.Views.SoftwareCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SoftwareCenterViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Essential Software Center" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource SegoeFluent}" />
                <TextBlock Text="Install curated, clean, bloat-free open-source applications directly via Windows Package Manager (Winget)." 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{DynamicResource StatusBadge}" Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="⚡ Winget Engine Ready" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWingetAvailable}" Value="False">
                                        <Setter Property="Text" Value="⚠️ Winget Not Found" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Button Content="🔄 Check Status" Style="{DynamicResource ModernButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Style="{DynamicResource PrimaryButton}" Command="{Binding InstallSelectedCommand}" IsEnabled="{Binding IsNotInstalling}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Install Selected (" />
                        <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" />
                        <TextBlock Text=")" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search & Category Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Style="{DynamicResource FluentCard}" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" 
                             BorderThickness="0" VerticalAlignment="Center" FontSize="13" FontFamily="{DynamicResource SegoeFluent}" />
                </Grid>
            </Border>

            <!-- Category Pills -->
            <Border Grid.Column="1" Background="#18181C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="All" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup" IsChecked="True" 
                                 Command="{Binding FilterCategoryCommand}" CommandParameter="All" />
                    <RadioButton Content="Utilities" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup"
                                 Command="{Binding FilterCategoryCommand}" CommandParameter="Utilities" />
                    <RadioButton Content="Browsers" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup"
                                 Command="{Binding FilterCategoryCommand}" CommandParameter="Browsers" />
                    <RadioButton Content="Developer" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup"
                                 Command="{Binding FilterCategoryCommand}" CommandParameter="Developer" />
                    <RadioButton Content="Media" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup"
                                 Command="{Binding FilterCategoryCommand}" CommandParameter="Media" />
                    <RadioButton Content="Security" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup"
                                 Command="{Binding FilterCategoryCommand}" CommandParameter="Security" />
                    <RadioButton Content="Productivity" Style="{DynamicResource SegmentPillButton}" GroupName="SoftwareCategoriesGroup"
                                 Command="{Binding FilterCategoryCommand}" CommandParameter="Productivity" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Selected Software Tray (Surfaces what has been selected) -->
        <Border Grid.Row="2" Style="{DynamicResource FluentCardElevated}" Margin="0,0,0,12" Padding="12,10"
                Visibility="{Binding HasSelectedPackages, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Selected for Install (" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="):" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                </StackPanel>

                <!-- Horizontal Scrollable Chips of Selected Packages -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedPackages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C2E3D" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                                        <Button Command="{Binding DataContext.UnselectPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Content="✕" Cursor="Hand" Background="Transparent" BorderThickness="0" 
                                                Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="11" Padding="2,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="2" Content="Clear All" Command="{Binding ClearSelectionCommand}" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                        FontSize="11" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Live Installation Progress Banner -->
        <Border Grid.Row="3" Background="#1C2538" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="📦 Installing Package via Winget..." FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{Binding InstallProgressStatus}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource AccentLightBrush}" />
            </StackPanel>
        </Border>

        <!-- Packages List / Cards -->
        <Border Grid.Row="4" Style="{DynamicResource FluentCard}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Packages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161619" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsInstalled, Converter={StaticResource InverseBoolConverter}}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <!-- Icon -->
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#202026" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Style="{DynamicResource StatusBadge}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Style="{DynamicResource StatusBadge}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="3" VerticalAlignment="Center" Margin="14,0" Padding="10,4" CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#222228" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Background" Value="#132E22" />
                                                        <Setter Property="BorderBrush" Value="#1B5E3C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding InstallStatus}" Value="Installing">
                                                        <Setter Property="Background" Value="#182E48" />
                                                        <Setter Property="BorderBrush" Value="#1E88E5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding InstallStatus}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding InstallStatus}" Value="Installing">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Action Button -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Button Content="Install" Style="{DynamicResource ModernButton}" Padding="12,5" FontSize="12"
                                                Command="{Binding DataContext.InstallSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                                        <TextBlock Text="✓ Ready" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
