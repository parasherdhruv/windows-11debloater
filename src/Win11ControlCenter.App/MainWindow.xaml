<Window x:Class="Win11ControlCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
        xmlns:views="clr-namespace:Win11ControlCenter.App.Views"
        mc:Ignorable="d"
        Title="Win11 Control Center" Height="800" Width="1240"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource SegoeFluent}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppDebloaterViewModel}">
            <views:AppDebloaterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SoftwareCenterViewModel}">
            <views:SoftwareCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupManagerViewModel}">
            <views:StartupManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesManagerViewModel}">
            <views:ServicesManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestoreCenterViewModel}">
            <views:RestoreCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityLogsViewModel}">
            <views:ActivityLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
            <views:PrivacyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationViewModel}">
            <views:OptimizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}">
            <views:GamingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemCleanerViewModel}">
            <views:SystemCleanerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomTweaksViewModel}">
            <views:CustomTweaksView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding Header Card -->
                <Border Grid.Row="0" Margin="12,12,12,8" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <Image Source="Assets/app.ico" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Win11 Control" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="6" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.2" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Debloater &amp; Optimization" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation List with Sections -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,4,10,10">
                        <!-- Section: System & Apps -->
                        <TextBlock Text="SYSTEM &amp; PACKAGES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="10,8,0,5" />
                        <RadioButton Style="{DynamicResource NavRadioButton}" IsChecked="True" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Dashboard" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="AppDebloater">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="App Debloater" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="SoftwareCenter">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Software Center" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="StartupManager">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Startup Manager" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="ServicesManager">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Windows Services" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Section: Optimization -->
                        <TextBlock Text="OPTIMIZATION &amp; TWEAKS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="10,18,0,5" />
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Privacy">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔒" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Privacy &amp; Telemetry" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Optimization">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✨" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Windows Tweaks" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Gaming">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎮" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Gaming Mode" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="SystemCleaner">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧹" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="System Cleaner" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="CustomTweaks">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛠️" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Custom Tweaks" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Section: Recovery & Audit -->
                        <TextBlock Text="SAFETY &amp; AUDIT" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="10,18,0,5" />
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="RestoreCenter">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Restore Center" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="ActivityLogs">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📜" Width="22" FontSize="13.5" TextAlignment="Center" FontFamily="{DynamicResource SegoeEmoji}" Margin="0,0,10,0" />
                                <TextBlock Text="Activity Logs" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Sidebar: Appearance & Settings Dock -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,12">
                    <StackPanel>
                        <!-- Settings Navigation Item -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" Width="22" FontSize="13.5" TextAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Application Settings" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Section Label & Current Theme -->
                        <Grid Margin="4,0,4,8">
                            <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentLightBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding EffectiveThemeText}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Sleek Theme Segmented Pill Switcher -->
                        <Border Background="{DynamicResource PillRailBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="2" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 1. OS System Default -->
                                <Button Grid.Column="0" ToolTip="System (Auto-sync with Windows 11 Light/Dark Mode)" 
                                        Command="{Binding SelectThemeCommand}" CommandParameter="System" Cursor="Hand" BorderThickness="0" Margin="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="pill" Background="Transparent" CornerRadius="12" Padding="0,5">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="💻" FontSize="11" />
                                                                <TextBlock x:Name="lbl" Text="OS" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSystemTheme}" Value="True">
                                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF" />
                                                                <Setter TargetName="lbl" Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 2. Fluent Dark -->
                                <Button Grid.Column="1" ToolTip="Fluent Dark Theme" 
                                        Command="{Binding SelectThemeCommand}" CommandParameter="Dark" Cursor="Hand" BorderThickness="0" Margin="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="pill" Background="Transparent" CornerRadius="12" Padding="0,5">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="🌙" FontSize="11" />
                                                                <TextBlock x:Name="lbl" Text="Dark" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF" />
                                                                <Setter TargetName="lbl" Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 3. Fluent Light -->
                                <Button Grid.Column="2" ToolTip="Fluent Light Theme" 
                                        Command="{Binding SelectThemeCommand}" CommandParameter="Light" Cursor="Hand" BorderThickness="0" Margin="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="pill" Background="Transparent" CornerRadius="12" Padding="0,5">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="☀️" FontSize="11" />
                                                                <TextBlock x:Name="lbl" Text="Light" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF" />
                                                                <Setter TargetName="lbl" Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 4. Midnight OLED -->
                                <Button Grid.Column="3" ToolTip="Midnight OLED (Pitch Black)" 
                                        Command="{Binding SelectThemeCommand}" CommandParameter="OLED" Cursor="Hand" BorderThickness="0" Margin="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="pill" Background="Transparent" CornerRadius="12" Padding="0,5">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="🌌" FontSize="11" />
                                                                <TextBlock x:Name="lbl" Text="OLED" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsOledTheme}" Value="True">
                                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF" />
                                                                <Setter TargetName="lbl" Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Main View Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <!-- Status Badges & Admin Switcher -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{DynamicResource StatusBadge}" Margin="0,0,8,0">
                            <TextBlock Text="Windows 11 x64" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        
                        <!-- Elevation Status Badge -->
                        <Border Style="{DynamicResource StatusBadge}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️ " FontSize="11" />
                                <TextBlock Text="{Binding ElevationStatusText}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Relaunch as Admin Button (Only shown when not elevated) -->
                        <Button Content="🛡️ Elevate as Admin" Style="{DynamicResource ModernButton}" 
                                Command="{Binding RelaunchElevatedCommand}"
                                Padding="10,4" FontSize="11"
                                Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
