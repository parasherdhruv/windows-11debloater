<Window x:Class="Win11ControlCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Win11ControlCenter.App.ViewModels"
        xmlns:views="clr-namespace:Win11ControlCenter.App.Views"
        mc:Ignorable="d"
        Title="Win11 Control Center" Height="800" Width="1240"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource SegoeFluent}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppDebloaterViewModel}">
            <views:AppDebloaterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SoftwareCenterViewModel}">
            <views:SoftwareCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupManagerViewModel}">
            <views:StartupManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesManagerViewModel}">
            <views:ServicesManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestoreCenterViewModel}">
            <views:RestoreCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityLogsViewModel}">
            <views:ActivityLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
            <views:PrivacyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationViewModel}">
            <views:OptimizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}">
            <views:GamingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemCleanerViewModel}">
            <views:SystemCleanerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomTweaksViewModel}">
            <views:CustomTweaksView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Row="0" Margin="20,22,20,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="7" Background="#1A0078D4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Win11 Control" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Debloater &amp; Optimization" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation List with Sections -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,0,10,10">
                        <!-- Section: System & Apps -->
                        <TextBlock Text="SYSTEM &amp; PACKAGES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="12,10,0,4" />
                        <RadioButton Content="📊  Dashboard" Style="{DynamicResource NavRadioButton}" IsChecked="True" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                        <RadioButton Content="🗑️  App Debloater" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="AppDebloater" />
                        <RadioButton Content="📦  Software Center" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="SoftwareCenter" />
                        <RadioButton Content="🚀  Startup Manager" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="StartupManager" />
                        <RadioButton Content="⚙️  Windows Services" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="ServicesManager" />

                        <!-- Section: Optimization -->
                        <TextBlock Text="OPTIMIZATION &amp; TWEAKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="12,14,0,4" />
                        <RadioButton Content="🔒  Privacy &amp; Telemetry" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Privacy" />
                        <RadioButton Content="✨  Windows Tweaks" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Optimization" />
                        <RadioButton Content="🎮  Gaming Mode" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="Gaming" />
                        <RadioButton Content="🧹  System Cleaner" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="SystemCleaner" />
                        <RadioButton Content="🛠️  Custom Tweaks" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="CustomTweaks" />

                        <!-- Section: Recovery & Audit -->
                        <TextBlock Text="SAFETY &amp; AUDIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="12,14,0,4" />
                        <RadioButton Content="🛡️  Restore Center" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="RestoreCenter" />
                        <RadioButton Content="📜  Activity Logs" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                     Command="{Binding NavigateCommand}" CommandParameter="ActivityLogs" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Sidebar: Settings -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,12">
                    <RadioButton Content="⚙️  Settings" Style="{DynamicResource NavRadioButton}" GroupName="SidebarNavGroup"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </Border>
            </Grid>
        </Border>

        <!-- Right Main View Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <!-- Status Badges & Admin Switcher -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{DynamicResource StatusBadge}" Margin="0,0,8,0">
                            <TextBlock Text="Windows 11 x64" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        
                        <!-- Elevation Status Badge -->
                        <Border Style="{DynamicResource StatusBadge}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️ " FontSize="11" />
                                <TextBlock Text="{Binding ElevationStatusText}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Relaunch as Admin Button (Only shown when not elevated) -->
                        <Button Content="🛡️ Elevate as Admin" Style="{DynamicResource ModernButton}" 
                                Command="{Binding RelaunchElevatedCommand}"
                                Padding="10,4" FontSize="11"
                                Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
